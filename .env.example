# Токен бота (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=
# Application ID (Discord Developer Portal → General Information)
CLIENT_ID=
# ID сервера, на котором регистрируются slash-команды
GUILD_ID=
# Путь к файлу базы данных SQLite
DB_PATH=data/fishing.db
# Часовой пояс по умолчанию (сбросы испытаний, время суток)
TZ_DEFAULT=Europe/Moscow
